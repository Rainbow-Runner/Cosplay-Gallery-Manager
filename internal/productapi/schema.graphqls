enum BrowseScope { LIST MAGIC ALL }
enum GallerySort { RECENTLY_ADDED NAME SHOOT_DATE RATING }
enum CollectionType { ALBUM COSPLAY }
enum ContentRating { NON_ADULT ADULT }
enum ShootDatePrecision { DAY MONTH UNKNOWN }
enum MediaKind { STATIC_IMAGE ANIMATED_IMAGE VIDEO }
enum ImageCategory { PHOTO SELFIE }
enum ContentFormat { IMAGE VIDEO RAW }
enum ProcessingState { PENDING PROCESSING READY ERROR }
enum RandomMediaFilter { ALL PHOTO SELFIE GIF VIDEO }
enum SearchEntityKind { GALLERY COSER WORK CHARACTER TAG }
enum EntitySort { NAME RECENTLY_ADDED }
enum GalleryState { DRAFT ACTIVE ARCHIVED }
scalar Int64

type EntitySummary { uuid: ID! name: String! }
type PersonSummary { uuid: ID! name: String! avatarURL: String }

type ResourceIdentity {
  itemUUID: ID!
  contentRevision: Int64!
  profileHash: String!
  variant: String!
  mimeType: String!
}

type OnDemandResource {
  status: ProcessingState!
  resource: ResourceIdentity
  errorCode: String!
}
type VideoPlaybackStatus { itemUUID: ID! mode: String! status: ProcessingState! contentRevision: Int64! resource: ResourceIdentity errorCode: String! }

type GalleryCover {
  kind: String!
  revision: Int64!
  managed: Boolean!
  warning: Boolean!
  resource: ResourceIdentity
}

type MediaCounts { photo: Int! selfie: Int! gif: Int! video: Int! }

type BrowseGalleryCard {
  setID: ID!
  slug: String!
  title: String!
  collectionType: CollectionType!
  contentRating: ContentRating!
  cover: GalleryCover!
  credits: [PersonSummary!]!
  creditCount: Int!
  characters: [EntitySummary!]!
  characterCount: Int!
  works: [EntitySummary!]!
  workCount: Int!
  shootDate: String!
  shootDatePrecision: ShootDatePrecision!
  addedAtUTC: String!
  media: MediaCounts!
  favorite: Boolean!
  ratingHalfSteps: Int
  scrubberCount: Int!
  scrubberRevision: Int64!
}

type GalleryPage {
  items: [BrowseGalleryCard!]!
  page: Int!
  pageSize: Int!
  totalItems: Int!
  totalPages: Int!
}

type HomeGalleryPage { scope: BrowseScope! page: GalleryPage! }

type GalleryCreditDetail {
  coser: PersonSummary!
  characters: [EntitySummary!]!
  works: [EntitySummary!]!
}

type ExternalLink { uuid: ID! type: String! label: String! url: String! }

type GalleryDetail {
  card: BrowseGalleryCard!
  metadataRevision: Int64!
  description: String!
  photographerName: String!
  studioName: String!
  availableBytes: Int64!
  mediaParentDirectories: [String!]!
  credits: [GalleryCreditDetail!]!
  tags: [EntitySummary!]!
  externalLinks: [ExternalLink!]!
  redirected: Boolean!
}

type GalleryTagEditResult {
  metadataRevision: Int64!
  tags: [EntitySummary!]!
}

type GalleryMember {
  itemUUID: ID!
  mediaKind: MediaKind!
  contentFormat: ContentFormat!
  imageCategory: ImageCategory
  position: String!
  caption: String!
  processingState: ProcessingState!
  cardResource: ResourceIdentity
  largeResource: ResourceIdentity
  favorite: Boolean!
  ratingHalfSteps: Int
}

type GalleryMemberIndex {
  setID: ID!
  metadataRevision: Int64!
  scanRevision: Int64!
  items: [GalleryMember!]!
}

type GalleryRecommendation {
  card: BrowseGalleryCard!
  score: Float!
  reasons: [String!]!
}

type RandomMediaItem {
  itemUUID: ID!
  mediaKind: MediaKind!
  imageCategory: ImageCategory
  resource: ResourceIdentity!
  gallerySetID: ID!
  gallerySlug: String!
